# Copier ce fichier en .env puis remplir les valeurs. Ne JAMAIS commiter .env.
# Sans aucune clé d'API, l'application fonctionne entièrement en mode simulé.

# --- Django -----------------------------------------------------------------
# Obligatoire hors DEBUG. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS autorisées pour les formulaires (en plus de l'hôte Render).
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO
# True derrière un proxy de confiance (Render) : IP du client lue dans
# X-Forwarded-For pour la preuve de consentement.
USE_X_FORWARDED_FOR=False

# --- Base de données --------------------------------------------------------
# Vide = SQLite local (db.sqlite3). docker compose impose sa propre URL Postgres.
# DATABASE_URL=postgres://reves:reves@localhost:5432/reves

# --- Services IA (facultatifs) ----------------------------------------------
# Mistral : transcription Voxtral + analyse (Mistral Small).
MISTRAL_API_KEY=
# Versions datées, jamais d'alias -latest (le prix suit le modèle, D28).
MISTRAL_STT_MODEL=voxtral-mini-2602
MISTRAL_CHAT_MODEL=mistral-small-2603
# Scaleway : secours de l'analyse si Mistral échoue.
SCALEWAY_API_KEY=
SCALEWAY_CHAT_MODEL=mistral-small-3.2-24b-instruct-2506
# Black Forest Labs (FLUX) : génération d'image.
BFL_API_KEY=
# mock (défaut, image générée localement) | bfl
IMAGE_PROVIDER=mock
BFL_API_BASE=https://api.eu.bfl.ai
BFL_MODEL=flux-3-image-klein

# --- Budget et conservation -------------------------------------------------
MONTHLY_BUDGET_USD=20
# Limites d'un enregistrement (10 Mo, 5 minutes).
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_SECONDS=300
# Tarifs dans la devise de facturation (D28). Euros convertis en dollars avec
# un taux volontairement haut : le budget est surestimé, jamais sous-estimé.
EUR_TO_USD_RATE=1.21
# Voxtral, en euros par seconde d'audio (facture du 2026-11-10).
VOXTRAL_COST_PER_SECOND_EUR=0.0000425
# LLM, en euros par million de tokens (entrée / sortie).
MISTRAL_INPUT_COST_PER_M_EUR=0.13
MISTRAL_OUTPUT_COST_PER_M_EUR=0.51
SCALEWAY_INPUT_COST_PER_M_EUR=0.15
SCALEWAY_OUTPUT_COST_PER_M_EUR=0.35
# Coût d'une image en dollars si BFL ne l'annonce pas dans sa réponse.
BFL_COST_PER_IMAGE_USD=0.009
DREAM_RETENTION_DAYS=365

# --- Monitoring (facultatif) ------------------------------------------------
# Vide = Sentry désactivé. Aucun contenu de rêve n'est envoyé (D33).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
