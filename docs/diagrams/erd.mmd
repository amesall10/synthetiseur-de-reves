erDiagram
  USER ||--o{ DREAM : "possède"
  USER ||--o{ CONSENT_RECORD : "donne"
  USER |o--o{ API_CALL : "consomme"
  DREAM ||--o{ API_CALL : "déclenche"
  DREAM |o--o{ CONSENT_RECORD : "couvert par"
  USER {
    int id PK
    string username UK
    string password "hachage PBKDF2"
    datetime date_joined
  }
  DREAM {
    int id PK
    int user_id FK
    datetime created_at
    datetime updated_at
    string status "uploaded|transcribed|analyzed|done|failed"
    string failure_reason
    binary audio "temporaire, vidé après STT"
    string audio_mime
    float audio_duration_s "nullable, calculée serveur"
    text transcript
    string emotion "6 choix, vide avant analyse"
    float intensity "nullable, 0 à 1"
    json themes "5 max"
    text summary
    text image_prompt
    binary image
    string image_mime
    string stt_source "real|fallback|mock"
    string analyze_source
    string image_source
    datetime step_started_at "verrou d'étape"
    decimal cost_usd
  }
  CONSENT_RECORD {
    int id PK
    int user_id FK
    int dream_id FK "nullable"
    string consent_type
    string text_version
    datetime granted_at "serveur"
    ip ip_address "nullable"
  }
  API_CALL {
    int id PK
    int user_id FK "nullable, CASCADE"
    int dream_id FK "nullable"
    string step "stt|analyze|image"
    string provider
    string model "vide si simulé"
    int status_code "nullable"
    int latency_ms
    int attempts
    string source
    decimal cost_usd
    string error
    datetime created_at
  }
  USAGE_CARRYOVER {
    int id PK
    decimal cost_usd "report anonyme du coût d'un compte supprimé (D34)"
  }
